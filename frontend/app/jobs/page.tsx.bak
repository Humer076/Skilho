'use client';

import { useEffect, useState, Suspense } from 'react';
import { useSearchParams } from 'next/navigation';
import Link from 'next/link';
import Reveal from '../components/Reveal';
import {
  EXPERIENCE_OPTIONS,
  JOINING_OPTIONS,
  SPECIALIZATIONS,
  WORK_TYPE_OPTIONS,
  labelOf,
} from '../lib/jobOptions';
import { postedText, salaryText } from '../lib/jobFormat';

const API = 'http://localhost:3000';
const FORM_ID = 'jobs-form';

type Filters = {
  q: string;
  specialization: string;
  experience: string;
  joining: string;
  location: string;
  minSalary: string;
};

const EMPTY: Filters = {
  q: '',
  specialization: '',
  experience: '',
  joining: '',
  location: '',
  minSalary: '',
};

type JobCard = {
  id: string;
  title: string;
  category: string;
  vacancies: number;
  specializations: string[];
  experience: string;
  salaryMin: number | null;
  salaryMax: number | null;
  salaryNegotiable: boolean;
  city: string;
  state: string;
  workType: string;
  joiningPreference: string;
  publishedAt: string | null;
  createdAt: string;
  company: {
    name: string;
    verified: boolean;
  };
};

type Result = {
  items: JobCard[];
  total: number;
  page: number;
  totalPages: number;
};

const FIELD =
  'w-full rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 text-sm text-slate-800 outline-none transition duration-200 placeholder:text-slate-400 focus:border-violet-500 focus:ring-4 focus:ring-violet-500/10';

const LABEL = 'mb-1.5 block text-sm font-semibold text-slate-700';

const PRIMARY_BUTTON =
  'inline-flex items-center justify-center gap-2 rounded-xl bg-violet-600 px-4 py-2.5 text-sm font-semibold text-white transition-all duration-200 hover:bg-violet-700 hover:shadow-lg hover:shadow-violet-600/20 focus:outline-none focus:ring-4 focus:ring-violet-500/20 active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-40';

const OUTLINE_BUTTON =
  'inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition-all duration-200 hover:border-violet-300 hover:bg-violet-50 hover:text-violet-700 focus:outline-none focus:ring-4 focus:ring-violet-500/10 disabled:cursor-not-allowed disabled:opacity-40';

function Icon({
  children,
  size = 20,
  className = '',
}: {
  children: React.ReactNode;
  size?: number;
  className?: string;
}) {
  return (
    <svg
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      strokeWidth="1.8"
      strokeLinecap="round"
      strokeLinejoin="round"
      className={className}
      aria-hidden="true"
    >
      {children}
    </svg>
  );
}

function SearchIcon({ size = 18 }: { size?: number }) {
  return (
    <Icon size={size}>
      <circle cx="11" cy="11" r="7" />
      <path d="m20 20-4-4" />
    </Icon>
  );
}

function PinIcon({ size = 16 }: { size?: number }) {
  return (
    <Icon size={size}>
      <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z" />
      <circle cx="12" cy="10" r="2.5" />
    </Icon>
  );
}

function CheckIcon() {
  return (
    <Icon size={14}>
      <path d="m5 12 4 4L19 6" />
    </Icon>
  );
}

function FilterIcon({ size = 18 }: { size?: number }) {
  return (
    <Icon size={size}>
      <path d="M4 6h16M7 12h10M10 18h4" />
    </Icon>
  );
}

function ArrowRightIcon({ size = 17 }: { size?: number }) {
  return (
    <Icon size={size}>
      <path d="M5 12h14" />
      <path d="m13 6 6 6-6 6" />
    </Icon>
  );
}

function BriefcaseIcon({ size = 22 }: { size?: number }) {
  return (
    <Icon size={size}>
      <rect x="3" y="7" width="18" height="14" rx="2" />
      <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
      <path d="M3 12h18M10 12v2h4v-2" />
    </Icon>
  );
}

function SkeletonCard() {
  return (
    <div
      className="animate-pulse rounded-2xl border border-slate-200 bg-white p-5"
      aria-hidden="true"
    >
      <div className="flex gap-4">
        <div className="h-12 w-12 shrink-0 rounded-xl bg-slate-100" />
        <div className="flex-1 space-y-3">
          <div className="h-4 w-2/3 rounded bg-slate-100" />
          <div className="h-3.5 w-1/3 rounded bg-slate-100" />
          <div className="h-3.5 w-1/2 rounded bg-slate-100" />
          <div className="flex flex-wrap gap-2 pt-2">
            <div className="h-6 w-20 rounded-full bg-violet-50" />
            <div className="h-6 w-24 rounded-full bg-slate-100" />
            <div className="h-6 w-16 rounded-full bg-slate-100" />
          </div>
        </div>
      </div>
    </div>
  );
}

function JobsContent() {
  const searchParams = useSearchParams();
  const initialQuery = searchParams.get('q') ?? '';

  const [form, setForm] = useState<Filters>({
    ...EMPTY,
    q: initialQuery,
  });

  const [applied, setApplied] = useState<Filters>({
    ...EMPTY,
    q: initialQuery,
  });

  const [page, setPage] = useState(1);
  const [result, setResult] = useState<Result | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState('');
  const [role, setRole] = useState<'employee' | 'employer' | null>(null);

  useEffect(() => {
    const q = searchParams.get('q') ?? '';

    setForm((previous) => ({ ...previous, q }));
    setApplied((previous) => ({ ...previous, q }));
    setPage(1);
  }, [searchParams]);

  // Identify the logged-in user without blocking public job listings.
  useEffect(() => {
    const token = localStorage.getItem('skilho_token');

    if (!token) return;

    fetch(`${API}/auth/me`, {
      headers: {
        Authorization: `Bearer ${token}`,
      },
    })
      .then((response) => (response.ok ? response.json() : null))
      .then((me) => {
        if (me?.role === 'EMPLOYER') {
          setRole('employer');
        } else if (me?.role === 'EMPLOYEE') {
          setRole('employee');
        }
      })
      .catch(() => {});
  }, []);

  // Fetch jobs whenever the applied filters or page changes.
  useEffect(() => {
    let cancelled = false;

    const params = new URLSearchParams();

    Object.entries(applied).forEach(([key, value]) => {
      if (value.trim() !== '') {
        params.set(key, value.trim());
      }
    });

    params.set('page', String(page));

    setLoading(true);
    setError('');

    fetch(`${API}/jobs?${params.toString()}`)
      .then((response) => {
        if (!response.ok) {
          throw new Error(`Could not load jobs (error ${response.status})`);
        }

        return response.json();
      })
      .then((data: Result) => {
        if (cancelled) return;

        setResult(data);
        setLoading(false);
      })
      .catch((err) => {
        if (cancelled) return;

        setError(
          err instanceof TypeError
            ? 'Cannot reach the backend. Please check that the backend is running on port 3000.'
            : err.message,
        );

        setLoading(false);
      });

    return () => {
      cancelled = true;
    };
  }, [applied, page]);

  function setField(key: keyof Filters, value: string) {
    setForm((previous) => ({
      ...previous,
      [key]: value,
    }));
  }

  function handleSearch(event: React.FormEvent<HTMLFormElement>) {
    event.preventDefault();
    setPage(1);
    setApplied({ ...form });
  }

  function clearFilters() {
    setForm({ ...EMPTY });
    setApplied({ ...EMPTY });
    setPage(1);
  }

  function goToPage(nextPage: number) {
    setPage(nextPage);
    window.scrollTo({
      top: 0,
      behavior: 'smooth',
    });
  }

  const activeCount = Object.values(applied).filter(
    (value) => value.trim() !== '',
  ).length;

  return (
    <main className="min-h-screen overflow-x-hidden bg-[#fafaff] text-slate-900 antialiased">
      {/* Header */}
      <header className="sticky top-0 z-50 border-b border-slate-100 bg-white/95 backdrop-blur-md">
        <div className="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
          <Link
            href="/"
            aria-label="Skilho home"
            className="flex shrink-0 items-center"
          >
            <img
              src="/skilho-logo.png"
              alt="Skilho"
              className="h-8 w-auto object-contain transition-transform duration-200 hover:scale-[1.03] sm:h-9"
            />
          </Link>

          {role && (
            <Link
              href={`/dashboard/${role}`}
              className={`${PRIMARY_BUTTON} px-3.5 py-2`}
            >
              <span className="hidden sm:inline">My dashboard</span>
              <span className="sm:hidden">Dashboard</span>
              <ArrowRightIcon size={15} />
            </Link>
          )}
        </div>
      </header>

      {/* Hero and search */}
      <section className="relative overflow-hidden border-b border-violet-100/80 bg-white">
        <div
          aria-hidden="true"
          className="pointer-events-none absolute -right-32 -top-32 h-80 w-80 rounded-full bg-violet-100/70 blur-3xl"
        />
        <div
          aria-hidden="true"
          className="pointer-events-none absolute -bottom-36 -left-32 h-80 w-80 rounded-full bg-indigo-50 blur-3xl"
        />

        <Reveal>
          <div className="relative mx-auto max-w-7xl px-4 pb-10 pt-8 sm:px-6 sm:pb-12 sm:pt-10 lg:px-8">
            <div className="mx-auto max-w-2xl text-center">
              <span className="inline-flex items-center gap-2 rounded-full border border-violet-100 bg-violet-50 px-3.5 py-1.5 text-[11px] font-bold uppercase tracking-[0.12em] text-violet-700 sm:text-xs">
                <span className="h-1.5 w-1.5 rounded-full bg-violet-600" />
                Opportunities for skilled professionals
              </span>

              <h1 className="mt-4 text-3xl font-extrabold leading-[1.15] tracking-tight text-[#17152b] sm:text-4xl md:text-5xl">
                Find your next{' '}
                <span className="text-violet-600">technician job.</span>
              </h1>

              <p className="mx-auto mt-4 max-w-xl text-sm leading-6 text-slate-500 sm:text-base sm:leading-7">
                Discover mobile and laptop repair jobs from trusted companies.
                Find the right opportunity and take the next step in your career
                with Skilho.
              </p>
            </div>

            {/* Main search */}
            <form
              id={FORM_ID}
              onSubmit={handleSearch}
              className="mx-auto mt-7 grid max-w-3xl gap-2.5 rounded-2xl border border-slate-200 bg-white p-2.5 shadow-[0_18px_55px_-35px_rgba(72,45,140,0.3)] sm:grid-cols-[1fr_0.7fr_auto] sm:gap-2"
            >
              <label className="flex min-w-0 items-center gap-2.5 rounded-xl px-3 transition-colors duration-200 focus-within:bg-violet-50/60">
                <span className="shrink-0 text-violet-600">
                  <SearchIcon />
                </span>

                <span className="sr-only">
                  Search by job title, skill or company
                </span>

                <input
                  type="text"
                  placeholder="Job title, skill or company"
                  value={form.q}
                  onChange={(event) => setField('q', event.target.value)}
                  className="w-full min-w-0 bg-transparent py-2.5 text-sm text-slate-800 outline-none placeholder:text-slate-400"
                />
              </label>

              <label className="flex min-w-0 items-center gap-2.5 rounded-xl border-t border-slate-100 px-3 transition-colors duration-200 focus-within:bg-violet-50/60 sm:border-l sm:border-t-0">
                <span className="shrink-0 text-violet-600">
                  <PinIcon size={18} />
                </span>

                <span className="sr-only">Location</span>

                <input
                  type="text"
                  placeholder="City or state"
                  value={form.location}
                  onChange={(event) => setField('location', event.target.value)}
                  className="w-full min-w-0 bg-transparent py-2.5 text-sm text-slate-800 outline-none placeholder:text-slate-400"
                />
              </label>

              <button
                type="submit"
                className={`${PRIMARY_BUTTON} min-h-11 sm:px-5`}
              >
                <SearchIcon />
                Search jobs
              </button>
            </form>

            <div className="mt-4 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-xs text-slate-500 sm:text-sm">
              <span className="inline-flex items-center gap-2">
                <span className="flex h-5 w-5 items-center justify-center rounded-full bg-emerald-50 text-emerald-600">
                  <CheckIcon />
                </span>
                Verified employers
              </span>

              <span className="inline-flex items-center gap-2">
                <span className="flex h-5 w-5 items-center justify-center rounded-full bg-violet-50 text-violet-600">
                  <BriefcaseIcon size={14} />
                </span>
                Skilled job opportunities
              </span>
            </div>
          </div>
        </Reveal>
      </section>

      {/* Filters and job results */}
      <section className="bg-[#fafaff]">
        <div className="mx-auto grid max-w-7xl items-start gap-6 px-4 py-8 sm:px-6 lg:grid-cols-[260px_minmax(0,1fr)] lg:gap-8 lg:px-8">
          {/* Filter sidebar */}
          <Reveal from="left" className="lg:sticky lg:top-20">
            <aside className="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
              <div className="flex items-center justify-between gap-3 border-b border-slate-100 pb-4">
                <h2 className="flex items-center gap-2.5 text-base font-bold text-[#17152b]">
                  <span className="flex h-8 w-8 items-center justify-center rounded-xl bg-violet-50 text-violet-700">
                    <FilterIcon />
                  </span>
                  Filters
                </h2>

                <button
                  type="button"
                  onClick={clearFilters}
                  className="text-xs font-semibold text-violet-700 transition-colors duration-200 hover:text-violet-900"
                >
                  Clear all
                </button>
              </div>

              <div className="mt-4 space-y-4">
                <div>
                  <label htmlFor="specialization" className={LABEL}>
                    Specialization
                  </label>

                  <select
                    id="specialization"
                    form={FORM_ID}
                    value={form.specialization}
                    onChange={(event) =>
                      setField('specialization', event.target.value)
                    }
                    className={FIELD}
                  >
                    <option value="">All specializations</option>

                    {SPECIALIZATIONS.map((specialization) => (
                      <option key={specialization} value={specialization}>
                        {specialization}
                      </option>
                    ))}
                  </select>
                </div>

                <div>
                  <label htmlFor="experience" className={LABEL}>
                    Experience
                  </label>

                  <select
                    id="experience"
                    form={FORM_ID}
                    value={form.experience}
                    onChange={(event) =>
                      setField('experience', event.target.value)
                    }
                    className={FIELD}
                  >
                    <option value="">Any experience</option>

                    {EXPERIENCE_OPTIONS.map((option) => (
                      <option key={option.value} value={option.value}>
                        {option.label}
                      </option>
                    ))}
                  </select>
                </div>

                <div>
                  <label htmlFor="joining" className={LABEL}>
                    Joining preference
                  </label>

                  <select
                    id="joining"
                    form={FORM_ID}
                    value={form.joining}
                    onChange={(event) =>
                      setField('joining', event.target.value)
                    }
                    className={FIELD}
                  >
                    <option value="">Any preference</option>

                    {JOINING_OPTIONS.map((option) => (
                      <option key={option.value} value={option.value}>
                        {option.label}
                      </option>
                    ))}
                  </select>
                </div>

                <div>
                  <label htmlFor="minSalary" className={LABEL}>
                    Minimum monthly salary
                  </label>

                  <div className="relative">
                    <span className="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-sm font-semibold text-slate-400">
                      ₹
                    </span>

                    <input
                      id="minSalary"
                      form={FORM_ID}
                      type="number"
                      min={0}
                      placeholder="e.g. 15000"
                      value={form.minSalary}
                      onChange={(event) =>
                        setField('minSalary', event.target.value)
                      }
                      className={`${FIELD} pl-8`}
                    />
                  </div>
                </div>

                <button
                  type="submit"
                  form={FORM_ID}
                  className={`${PRIMARY_BUTTON} w-full`}
                >
                  Apply filters
                  <ArrowRightIcon size={16} />
                </button>
              </div>

              <div className="mt-4 rounded-xl bg-violet-50/70 p-4">
                <p className="text-sm font-semibold text-slate-800">
                  Find the right fit
                </p>
                <p className="mt-1 text-xs leading-5 text-slate-500">
                  Refine your search to discover jobs that better match your
                  skills and preferences.
                </p>
              </div>
            </aside>
          </Reveal>

          {/* Results area */}
          <div className="min-w-0" aria-live="polite">
            {error && (
              <div
                role="alert"
                className="mb-5 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"
              >
                {error}
              </div>
            )}

            <div className="mb-5 flex flex-wrap items-center justify-between gap-3">
              <div>
                <span className="text-[11px] font-bold uppercase tracking-[0.13em] text-violet-700">
                  JOB OPPORTUNITIES
                </span>

                <h2 className="mt-1 text-xl font-extrabold tracking-tight text-[#17152b] sm:text-2xl">
                  Explore jobs
                </h2>

                <p className="mt-1 text-sm text-slate-500">
                  Find your next career opportunity with Skilho.
                </p>
              </div>

              {activeCount > 0 && (
                <button
                  type="button"
                  onClick={clearFilters}
                  className={OUTLINE_BUTTON}
                >
                  <FilterIcon />
                  {activeCount} active{' '}
                  {activeCount === 1 ? 'filter' : 'filters'}
                </button>
              )}
            </div>

            {loading && (
              <div className="space-y-4">
                <SkeletonCard />
                <SkeletonCard />
                <SkeletonCard />
              </div>
            )}

            {!loading && result && (
              <>
                <div className="mb-4 flex items-center gap-2 text-sm text-slate-500">
                  <span className="inline-flex min-w-8 items-center justify-center rounded-lg bg-violet-100 px-2.5 py-1 font-bold text-violet-700">
                    {result.total}
                  </span>

                  <span>{result.total === 1 ? 'job found' : 'jobs found'}</span>
                </div>

                {result.items.length === 0 ? (
                  <Reveal from="zoom">
                    <div className="rounded-2xl border border-slate-200 bg-white px-5 py-12 text-center shadow-sm sm:px-10">
                      <span className="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-violet-50 text-violet-700">
                        <BriefcaseIcon />
                      </span>

                      <h3 className="mt-4 text-lg font-bold text-[#17152b]">
                        No jobs found
                      </h3>

                      <p className="mx-auto mt-2 max-w-md text-sm leading-6 text-slate-500">
                        We couldn&apos;t find jobs matching your current search.
                        Try changing your filters or searching another location.
                      </p>

                      <button
                        type="button"
                        onClick={clearFilters}
                        className={`${PRIMARY_BUTTON} mt-6`}
                      >
                        Clear filters
                      </button>
                    </div>
                  </Reveal>
                ) : (
                  <ul className="space-y-4">
                    {result.items.map((job, index) => (
                      <li key={job.id}>
                        <Reveal delay={(index % 4) * 50}>
                          <Link
                            href={`/jobs/${job.id}`}
                            className="group block rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-violet-200 hover:shadow-[0_14px_35px_-22px_rgba(109,40,217,0.35)]"
                          >
                            <div className="flex items-start gap-4">
                              <div
                                className="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-violet-50 text-base font-extrabold text-violet-700 transition-colors duration-200 group-hover:bg-violet-100 sm:h-12 sm:w-12 sm:rounded-2xl sm:text-lg"
                                aria-hidden="true"
                              >
                                {job.company.name?.[0]?.toUpperCase() ?? 'C'}
                              </div>

                              <div className="min-w-0 flex-1">
                                <div className="flex flex-wrap items-start justify-between gap-2">
                                  <h3 className="text-base font-bold leading-snug text-[#17152b] transition-colors duration-200 group-hover:text-violet-700 sm:text-lg">
                                    {job.title}
                                  </h3>

                                  <span className="shrink-0 pt-0.5 text-xs text-slate-400">
                                    {postedText(
                                      job.publishedAt ?? job.createdAt,
                                    )}
                                  </span>
                                </div>

                                <div className="mt-1 flex flex-wrap items-center gap-2">
                                  <span className="text-sm font-medium text-slate-600">
                                    {job.company.name}
                                  </span>

                                  {job.company.verified && (
                                    <span className="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2.5 py-0.5 text-[11px] font-semibold text-emerald-700">
                                      <CheckIcon />
                                      Verified
                                    </span>
                                  )}
                                </div>

                                <p className="mt-3 text-base font-extrabold text-violet-700">
                                  {salaryText(
                                    job.salaryMin,
                                    job.salaryMax,
                                    job.salaryNegotiable,
                                  )}
                                </p>

                                <div className="mt-3 flex flex-wrap gap-2">
                                  <span className="inline-flex items-center gap-1.5 rounded-lg bg-slate-50 px-2.5 py-1.5 text-xs font-medium text-slate-600">
                                    <PinIcon size={14} />
                                    {[job.city, job.state]
                                      .filter(Boolean)
                                      .join(', ') || 'Location not specified'}
                                  </span>

                                  <span className="rounded-lg bg-violet-50 px-2.5 py-1.5 text-xs font-semibold text-violet-700">
                                    {labelOf(WORK_TYPE_OPTIONS, job.workType)}
                                  </span>

                                  <span className="rounded-lg bg-slate-50 px-2.5 py-1.5 text-xs font-medium text-slate-600">
                                    {labelOf(
                                      EXPERIENCE_OPTIONS,
                                      job.experience,
                                    )}
                                  </span>

                                  <span className="rounded-lg bg-slate-50 px-2.5 py-1.5 text-xs font-medium text-slate-600">
                                    {labelOf(
                                      JOINING_OPTIONS,
                                      job.joiningPreference,
                                    )}
                                  </span>

                                  <span className="rounded-lg bg-slate-50 px-2.5 py-1.5 text-xs font-medium text-slate-600">
                                    {job.vacancies}{' '}
                                    {job.vacancies === 1
                                      ? 'vacancy'
                                      : 'vacancies'}
                                  </span>
                                </div>

                                <div className="mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 pt-4">
                                  <div className="flex flex-wrap gap-2">
                                    {job.specializations
                                      .slice(0, 4)
                                      .map((specialization) => (
                                        <span
                                          key={specialization}
                                          className="rounded-lg border border-slate-200 bg-white px-2.5 py-1 text-xs font-medium text-slate-600"
                                        >
                                          {specialization}
                                        </span>
                                      ))}

                                    {job.specializations.length > 4 && (
                                      <span className="px-1 py-1 text-xs font-medium text-slate-400">
                                        +{job.specializations.length - 4} more
                                      </span>
                                    )}
                                  </div>

                                  <span className="inline-flex items-center gap-2 text-sm font-semibold text-violet-700">
                                    View details
                                    <span className="transition-transform duration-200 group-hover:translate-x-1">
                                      <ArrowRightIcon size={16} />
                                    </span>
                                  </span>
                                </div>
                              </div>
                            </div>
                          </Link>
                        </Reveal>
                      </li>
                    ))}
                  </ul>
                )}

                {result.totalPages > 1 && (
                  <nav
                    aria-label="Job pagination"
                    className="mt-8 flex flex-wrap items-center justify-center gap-3"
                  >
                    <button
                      type="button"
                      disabled={result.page <= 1 || loading}
                      onClick={() => goToPage(result.page - 1)}
                      className={OUTLINE_BUTTON}
                    >
                      ← Previous
                    </button>

                    <span className="rounded-xl border border-violet-100 bg-violet-50 px-4 py-2.5 text-sm font-semibold text-violet-700">
                      Page {result.page} of {result.totalPages}
                    </span>

                    <button
                      type="button"
                      disabled={result.page >= result.totalPages || loading}
                      onClick={() => goToPage(result.page + 1)}
                      className={OUTLINE_BUTTON}
                    >
                      Next <ArrowRightIcon size={15} />
                    </button>
                  </nav>
                )}
              </>
            )}
          </div>
        </div>
      </section>

      {/* Footer */}
      <footer className="border-t border-slate-200 bg-white">
        <div className="mx-auto max-w-7xl px-4 py-6 text-center sm:px-6 lg:px-8">
          <p className="text-sm text-slate-500">
            Connecting skilled people with better opportunities.
          </p>
        </div>

        <div className="border-t border-slate-100 py-4 text-center text-xs text-slate-400">
          © 2026 Skilho. All rights reserved.
        </div>
      </footer>
    </main>
  );
}

export default function JobsPage() {
  return (
    <Suspense
      fallback={
        <div className="flex min-h-screen items-center justify-center bg-[#fafaff] text-sm font-medium text-slate-500">
          Loading jobs...
        </div>
      }
    >
      <JobsContent />
    </Suspense>
  );
}